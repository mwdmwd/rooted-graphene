{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':dependencyDashboard',
  ],
  ignorePresets: [
    'helpers:pinGitHubActionDigests',
  ],
  prHourlyLimit: 0,
  automerge: false,
  printConfig: true,
  labels: [
    'dependencies',
  ],
  vulnerabilityAlerts: {
    labels: [
      'security',
      'dependencies',
    ],
  },
  packageRules: [
    {
      matchPackageNames: [
        '*',
      ],
      description: 'Require manual merging for all dependency updates',
      automerge: false,
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'pixincreate/Magisk',
      ],
      ignoreUnstable: false,
      respectLatest: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/rooted-ota.sh/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s.+?_VERSION=(?<currentValue>.+?)\\s',
        '# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: currentValue=(?<currentValue>[a-z-]+?))?\\s.+?_COMMIT=(?<currentDigest>.+?)\\s',
      ],
    },
  ],
}
